# Copy to .env.local. Never commit real credentials.
GEMINI_API_KEY=
# Choose a supported free-tier Flash model after checking your AI Studio account.
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: set only for a search-enabled Gemini account; Flash-Lite free tier
# does not include Google Search grounding. Never enable paid billing implicitly.
GEMINI_RESEARCH_MODEL=
